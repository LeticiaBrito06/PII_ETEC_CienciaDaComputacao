-- VIEW: resumo de desempenho de todos os alunos (para o professor)
CREATE OR REPLACE VIEW vw_desempenho_alunos AS
    SELECT
        u.id AS id_aluno,
        u.nome AS nome_aluno,
        u.email AS email_aluno,
        d.total_partidas,
        d.total_acertos,
        d.total_erros,
        d.percentual_acerto,
        d.nivel_medio,
        d.atualizado_em
    FROM usuario u INNER JOIN desempenho d ON d.id_aluno = u.id WHERE u.tipo = 'ALUNO' ORDER BY d.percentual_acerto DESC;

-- VIEW: histórico completo de respostas de uma partida
CREATE OR REPLACE VIEW vw_historico_partida AS
    SELECT
        p.id AS id_partida,
        u.nome AS nome_aluno,
        p.data_hora_inicio,
        p.data_hora_fim,
        p.pontuacao,
        p.nivel_atual,
        q.enunciado AS pergunta,
        q.nivel_dificuldade,
        a.texto AS alternativa_escolhida,
        r.correta
    FROM resposta r INNER JOIN partida p ON p.id = r.id_partida INNER JOIN usuario u ON u.id = p.id_aluno
    INNER JOIN questao q ON q.id = r.id_questao INNER JOIN alternativa a ON a.id = r.id_alternativa ORDER BY p.id, r.id;

-- VIEW: banco de questões ativas com total de alternativas
CREATE OR REPLACE VIEW vw_questoes_ativas AS
    SELECT
        q.id,
        q.enunciado,
        q.tipo,
        q.nivel_dificuldade,
        q.categoria,
        q.imagem_url,
        u.nome AS cadastrada_por,
        q.criada_em,
        COUNT(a.id) AS total_alternativas
    FROM questao q INNER JOIN usuario u ON u.id = q.id_professor LEFT JOIN alternativa a ON a.id_questao = q.id WHERE q.ativa = TRUE 
    GROUP BY q.id, q.enunciado, q.tipo, q.nivel_dificuldade, q.categoria, q.imagem_url, u.nome, q.criada_em
    ORDER BY q.nivel_dificuldade, q.id;

-- PROCEDURES
DELIMITER $$

-- Procedure: atualiza o desempenho consolidado do aluno após cada partida
CREATE PROCEDURE sp_atualizar_desempenho(IN p_id_aluno INT)
BEGIN
    DECLARE v_total_partidas INT;
    DECLARE v_total_acertos INT;
    DECLARE v_total_erros INT;
    DECLARE v_percentual DOUBLE;
    DECLARE v_nivel_medio ENUM('FACIL', 'MEDIO', 'DIFICIL');  -- CORREÇÃO: tipo correto

    -- Calcula os totais com base nas partidas finalizadas
    SELECT
        COUNT(DISTINCT p.id),
        SUM(CASE WHEN r.correta = TRUE THEN 1 ELSE 0 END),
        SUM(CASE WHEN r.correta = FALSE THEN 1 ELSE 0 END)
    INTO v_total_partidas, v_total_acertos, v_total_erros FROM partida p INNER JOIN resposta r ON r.id_partida = p.id
    WHERE p.id_aluno = p_id_aluno AND p.finalizada = TRUE;

    -- Garante valores não nulos
    SET v_total_partidas = IFNULL(v_total_partidas, 0);
    SET v_total_acertos = IFNULL(v_total_acertos, 0);
    SET v_total_erros = IFNULL(v_total_erros, 0);

    -- Calcula percentual de acerto
    IF (v_total_acertos + v_total_erros) = 0 THEN SET v_percentual = 0.0;
    ELSE SET v_percentual = (v_total_acertos / (v_total_acertos + v_total_erros)) * 100.0;
    END IF;

    -- Define nível médio baseado no percentual
    IF v_percentual >= 70 THEN SET v_nivel_medio = 'DIFICIL';
    ELSEIF v_percentual >= 40 THEN SET v_nivel_medio = 'MEDIO';
    ELSE SET v_nivel_medio = 'FACIL';
    END IF;

    -- Insere ou atualiza o desempenho (nunca inserir manualmente nesta tabela)
    INSERT INTO desempenho (id_aluno, total_partidas, total_acertos, total_erros, percentual_acerto, nivel_medio)
    VALUES (p_id_aluno, v_total_partidas, v_total_acertos, v_total_erros, v_percentual, v_nivel_medio)
    ON DUPLICATE KEY UPDATE
        total_partidas = v_total_partidas,
        total_acertos = v_total_acertos,
        total_erros = v_total_erros,
        percentual_acerto = v_percentual,
        nivel_medio = v_nivel_medio;
END$$

-- Procedure: finaliza uma partida e atualiza o desempenho do aluno
CREATE PROCEDURE sp_finalizar_partida(IN p_id_partida INT, IN p_pontuacao INT)
BEGIN
    DECLARE v_id_aluno INT;

    -- Busca o aluno da partida
    SELECT id_aluno INTO v_id_aluno FROM partida WHERE id = p_id_partida;

    -- Finaliza a partida
    UPDATE partida SET finalizada = TRUE, data_hora_fim = NOW(), pontuacao = p_pontuacao WHERE id = p_id_partida;

    -- Atualiza o desempenho consolidado do aluno
    CALL sp_atualizar_desempenho(v_id_aluno);
END$$

DELIMITER ;